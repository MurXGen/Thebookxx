{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "thebookx-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "exports-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "exports"
      ],
      "port": 8765
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "cwd": "mobile",
      "port": 8091
    },
    {
      "name": "mobile-api-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "mobile/scripts/dev-cors-proxy.mjs"
      ],
      "port": 8092
    },
    {
      "name": "next-prod-3005",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3005"
      ],
      "port": 3005
    }
  ]
}