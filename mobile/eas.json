{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "apk": {
      "android": { "buildType": "apk" }
    },
    "apk-legacy": {
      "extends": "apk",
      "env": { "TBX_ALL_ABIS": "1" }
    },
    "production": {
      "android": { "buildType": "app-bundle" }
    }
  }
}
